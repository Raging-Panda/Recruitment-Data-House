# --- Web login: GitHub OAuth App #1 (create at https://github.com/settings/developers) ---
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Mobile login: GitHub OAuth App #2 (separate app, own client id/secret) ---
# GitHub OAuth Apps only support one fixed callback URL, and the mobile app
# redirects to the "ipskill://" custom scheme, not http://localhost:3000/...,
# so it needs its own app. Authorization callback URL: ipskill://
# This app's secret is only ever used server-side by /api/mobile/github-token.
GITHUB_MOBILE_CLIENT_ID=
GITHUB_MOBILE_CLIENT_SECRET=

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Dev-only test login (see src/lib/test-mode.ts) ---
# When "true", registers an extra NextAuth "test-account" provider that
# logs straight in as a fixture developer (fake GitHub-shaped data, no
# real OAuth round trip) — a "Continue as Test User" button appears on
# the login page. NEVER set this on a real deployment; it isn't gated by
# NODE_ENV because Vercel builds preview deployments with
# NODE_ENV=production too, so an explicit opt-in env var is the only safe
# gate. Leave unset/false everywhere except your own local .env.local.
ALLOW_TEST_LOGIN=false

# --- Supabase (work history storage) ---
# Project: ipskill (https://supabase.com/dashboard/project/ovapgfrxfhzslsszeoxq)
SUPABASE_URL=https://ovapgfrxfhzslsszeoxq.supabase.co
# Service role (secret) key — Project Settings > API > service_role in the
# Supabase dashboard. Never expose this to the browser: it bypasses Row
# Level Security, which is why work_experience has RLS enabled with no
# policies (only this server-side key can read/write it). Do NOT prefix
# this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
