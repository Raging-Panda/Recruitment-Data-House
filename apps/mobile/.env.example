# Client ID from the "mobile" GitHub OAuth App (see apps/web/.env.example —
# GITHUB_MOBILE_CLIENT_ID/SECRET). Only the client ID is safe to ship in the
# app; the secret stays server-side in apps/web.
EXPO_PUBLIC_GITHUB_CLIENT_ID=

# Base URL of the running apps/web instance, used to exchange the GitHub
# authorization code for an access token via /api/mobile/github-token.
EXPO_PUBLIC_AUTH_BACKEND_URL=http://localhost:3000
